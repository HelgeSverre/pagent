{
  "name": "helgesverre/pagent",
  "description": "A Pest-inspired LLM Agent Framework for PHP with multi-provider support, automatic tool calling, safety guards, and multi-agent orchestration",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "ai",
    "llm",
    "agent",
    "chatbot",
    "anthropic",
    "openai",
    "claude",
    "gpt",
    "tool-calling",
    "pest",
    "php"
  ],
  "homepage": "https://github.com/helgesverre/pagent",
  "support": {
    "issues": "https://github.com/helgesverre/pagent/issues",
    "source": "https://github.com/helgesverre/pagent"
  },
  "authors": [
    {
      "name": "Helge Sverre",
      "email": "helge.sverre@gmail.com",
      "homepage": "https://helgesver.re"
    }
  ],
  "require": {
    "php": "^8.3",
    "ext-curl": "*",
    "nyholm/psr7": "^1.8",
    "open-telemetry/api": "^1.7",
    "open-telemetry/exporter-otlp": "^1.3",
    "open-telemetry/sdk": "^1.9",
    "open-telemetry/sem-conv": "^1.37",
    "psr/http-client": "^1.0",
    "psr/http-factory": "^1.0",
    "psr/log": "^3.0",
    "swaggest/json-schema": "^0.12.43",
    "symfony/process": "^7.3"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.0",
    "laravel/pint": "^1.24",
    "nunomaduro/phpinsights": "^2.13",
    "pestphp/pest": "^4.0",
    "phpstan/phpstan": "^1.10",
    "spatie/ray": "^1.42",
    "vlucas/phpdotenv": "^5.6"
  },
  "autoload": {
    "psr-4": {
      "Pagent\\": "src/"
    },
    "files": [
      "src/functions.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "vendor/bin/pest",
    "test:coverage": "vendor/bin/pest --coverage --min=80",
    "test:unit": "vendor/bin/pest --testsuite=Unit",
    "test:integration": "vendor/bin/pest --testsuite=Integration",
    "test:observability": "vendor/bin/pest --group=observability",
    "analyse": "phpstan analyse --memory-limit=1G",
    "analyse:baseline": "phpstan analyse --memory-limit=1G --generate-baseline",
    "analyse:clear": "phpstan clear-result-cache",
    "format": "pint",
    "format:check": "pint --test",
    "quality": [
      "@format:check",
      "@analyse",
      "@test"
    ],
    "quality:fix": [
      "@format",
      "@analyse",
      "@test"
    ],
    "insights": "phpinsights --no-interaction --min-quality=80 --min-complexity=80 --min-architecture=80 --min-style=80",
    "insights:fix": "phpinsights --fix",
    "check": [
      "@format:check",
      "@analyse"
    ]
  },
  "config": {
    "sort-packages": true,
    "preferred-install": "dist",
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "pestphp/pest-plugin": true,
      "php-http/discovery": true,
      "tbachert/spi": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
