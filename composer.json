{
    "name": "helgesverre/pagent",
    "description": "A Pest-inspired LLM Agent Framework for PHP",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Pagent Team",
            "email": "team@pagent.dev"
        }
    ],
    "require": {
        "php": "^8.3",
        "laravel/pint": "^1.24",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "nunomaduro/phpinsights": "^2.13",
        "pestphp/pest": "^4.0",
        "phpstan/phpstan": "^1.10",
        "spatie/ray": "^1.42",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "Pagent\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "analyse": "phpstan analyse",
        "fix": "php-cs-fixer fix"
    },
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
