{
  "name": "helgesverre/pagent",
  "description": "A Pest-inspired LLM Agent Framework for PHP with multi-provider support, automatic tool calling, safety guards, and multi-agent orchestration",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "ai",
    "llm",
    "agent",
    "chatbot",
    "anthropic",
    "openai",
    "claude",
    "gpt",
    "tool-calling",
    "pest",
    "php"
  ],
  "homepage": "https://github.com/helgesverre/pagent",
  "support": {
    "issues": "https://github.com/helgesverre/pagent/issues",
    "source": "https://github.com/helgesverre/pagent"
  },
  "authors": [
    {
      "name": "Helge Sverre",
      "email": "helge.sverre@gmail.com",
      "homepage": "https://helgesver.re"
    }
  ],
  "require": {
    "php": ">=8.4.1 <9.0",
    "ext-curl": "*",
    "ext-mbstring": "*",
    "psr/log": "^3.0"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.0",
    "laravel/pint": "^1.24",
    "nyholm/psr7": "^1.8",
    "open-telemetry/api": "^1.7",
    "open-telemetry/exporter-otlp": "^1.3",
    "open-telemetry/sdk": "^1.9",
    "open-telemetry/sem-conv": "^1.37",
    "pestphp/pest": "^5.1",
    "phpstan/phpstan": "^1.12.34",
    "psr/http-client": "^1.0",
    "psr/http-factory": "^1.0",
    "spatie/ray": "^1.42",
    "swaggest/json-schema": "^0.12.43",
    "symfony/http-client": "^8.1",
    "symfony/process": "^8.1",
    "teamtnt/tntsearch": "^5.3",
    "vlucas/phpdotenv": "^5.6"
  },
  "autoload": {
    "psr-4": {
      "Pagent\\": "src/"
    },
    "files": [
      "src/functions.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "vendor/bin/pest --exclude-group=live --exclude-group=external",
    "test:coverage": "vendor/bin/pest --coverage --min=80 --exclude-group=live --exclude-group=external",
    "test:unit": "vendor/bin/pest --testsuite=Unit --exclude-group=live --exclude-group=external",
    "test:integration": "vendor/bin/pest --testsuite=Integration --exclude-group=live --exclude-group=external",
    "test:live": "vendor/bin/pest --group=live",
    "test:external": "vendor/bin/pest --group=external",
    "test:observability": "vendor/bin/pest tests/Integration/Observability --group=external",
    "verify:packaging": "@php scripts/verify-packaging.php",
    "smoke:core": "@php scripts/smoke-core-runtime.php",
    "analyse": "phpstan analyse --memory-limit=1G",
    "analyse:baseline": "phpstan analyse --memory-limit=1G --generate-baseline",
    "analyse:clear": "phpstan clear-result-cache",
    "format": "pint",
    "format:check": "pint --test",
    "quality": [
      "@format:check",
      "@analyse",
      "@test"
    ],
    "quality:fix": [
      "@format",
      "@analyse",
      "@test"
    ],
    "check": [
      "@format:check",
      "@analyse"
    ]
  },
  "config": {
    "sort-packages": true,
    "preferred-install": "dist",
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "pestphp/pest-plugin": true,
      "php-http/discovery": true,
      "tbachert/spi": true
    }
  },
  "suggest": {
    "nyholm/psr7": "Enable the built-in Zipkin exporter, which needs a PSR-17 implementation.",
    "open-telemetry/api": "Enable Pagent telemetry APIs and built-in telemetry exporters.",
    "open-telemetry/exporter-otlp": "Enable OTLP trace exporting.",
    "open-telemetry/sdk": "Enable Pagent telemetry spans and exporters.",
    "open-telemetry/sem-conv": "Enable OpenTelemetry semantic-convention attributes.",
    "psr/http-client": "Enable HTTP-backed telemetry exporters.",
    "psr/http-factory": "Enable HTTP-backed telemetry exporters.",
    "swaggest/json-schema": "Enable the JsonSchemaMetric evaluation metric.",
    "symfony/http-client": "Enable the built-in Zipkin telemetry exporter.",
    "symfony/process": "Enable the built-in Bash tool.",
    "teamtnt/tntsearch": "Enable the built-in SearchTool."
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
