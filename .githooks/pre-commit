#!/bin/bash

# Pagent Framework - Pre-commit Hook
# Ensures code quality before allowing commits

set -e

echo "Running pre-commit checks..."

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Function to print colored output
print_status() {
    local color=$1
    local message=$2
    echo -e "${color}${message}${NC}"
}

# Check if we're in a git repository
if ! git rev-parse --git-dir > /dev/null 2>&1; then
    print_status "$RED" "Error: Not in a git repository"
    exit 1
fi

# Get list of staged PHP files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep '\.php$' || true)

if [ -z "$STAGED_FILES" ]; then
    print_status "$GREEN" "No PHP files staged for commit"
    exit 0
fi

print_status "$YELLOW" "Checking ${STAGED_FILES[@]} files..."

# 1. Check PHP syntax errors
print_status "$YELLOW" "1/3 Checking PHP syntax..."
for FILE in $STAGED_FILES; do
    php -l "$FILE" > /dev/null 2>&1
    if [ $? -ne 0 ]; then
        print_status "$RED" "PHP syntax error in $FILE"
        exit 1
    fi
done
print_status "$GREEN" "PHP syntax check passed"

# 2. Run Pint for code style
print_status "$YELLOW" "2/3 Running code formatter (Pint)..."
if ! composer format:check > /dev/null 2>&1; then
    print_status "$RED" "Code style issues detected!"
    print_status "$YELLOW" "Running automatic fix..."
    composer format

    # Stage the fixed files
    for FILE in $STAGED_FILES; do
        git add "$FILE"
    done

    print_status "$GREEN" "Code formatting applied and staged"
else
    print_status "$GREEN" "Code formatting check passed"
fi

# 3. Run PHPStan analysis (only on staged files)
print_status "$YELLOW" "3/3 Running static analysis (PHPStan)..."
if ! vendor/bin/phpstan analyse --no-progress --error-format=raw $STAGED_FILES > /dev/null 2>&1; then
    print_status "$RED" "PHPStan found issues!"
    print_status "$YELLOW" "Run 'composer analyse' for details"
    print_status "$YELLOW" "You can skip this check with 'git commit --no-verify'"
    exit 1
fi
print_status "$GREEN" "Static analysis passed"

print_status "$GREEN" "All pre-commit checks passed! Proceeding with commit..."
exit 0
