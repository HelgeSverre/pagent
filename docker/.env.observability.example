# Observability Stack Environment Variables
# Copy this file to .env.observability and customize for your environment

# =============================================================================
# Langfuse Configuration
# =============================================================================
# Database Configuration (uses langfuse-db service)
LANGFUSE_DB_NAME=langfuse
LANGFUSE_DB_USER=langfuse
LANGFUSE_DB_PASSWORD=langfuse_password

# Authentication & Security (CHANGE THESE IN PRODUCTION!)
LANGFUSE_NEXTAUTH_SECRET=changeme_langfuse_secret_key_min_32_chars_required_for_production
LANGFUSE_SALT=changeme_langfuse_salt_key
LANGFUSE_NEXTAUTH_URL=http://localhost:3000

# Feature Flags
LANGFUSE_TELEMETRY_ENABLED=true
LANGFUSE_EXPERIMENTAL=true

# API Keys (set via UI after first login or use headless initialization)
# For automated testing, you can use LANGFUSE_INIT_* variables:
# LANGFUSE_INIT_ORG_ID=org_id
# LANGFUSE_INIT_ORG_NAME=My Organization
# LANGFUSE_INIT_PROJECT_ID=proj_id
# LANGFUSE_INIT_PROJECT_NAME=My Project
# LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk_xxx
# LANGFUSE_INIT_PROJECT_SECRET_KEY=sk_xxx
# LANGFUSE_INIT_USER_EMAIL=admin@example.com
# LANGFUSE_INIT_USER_NAME=Admin User
# LANGFUSE_INIT_USER_PASSWORD=changeme

# =============================================================================
# Opik Configuration (Comet)
# =============================================================================
# MySQL Database Configuration
OPIK_DB_NAME=opik
OPIK_DB_USER=opik
OPIK_DB_PASSWORD=opik_password
OPIK_MYSQL_ROOT_PASSWORD=opik_root_password

# Telemetry
OPIK_TELEMETRY_ENABLED=false

# SDK Configuration (for automated testing)
# OPIK_API_KEY=opik_key_xxx
# OPIK_URL_OVERRIDE=http://localhost:8080
# OPIK_WORKSPACE=default

# =============================================================================
# Helicone Configuration
# =============================================================================
# Database URL (PostgreSQL)
HELICONE_DATABASE_URL=postgresql://postgres:postgres@helicone-db:5432/helicone
HELICONE_NEXT_PUBLIC_BASE_PATH=http://localhost:3001

# API Configuration (set via UI after first login)
# For automated testing, create API keys through the UI first
# HELICONE_API_KEY=sk_helicone_xxx

# =============================================================================
# Phoenix Configuration (Arize)
# =============================================================================
# Server Configuration
PHOENIX_PORT=6006
PHOENIX_GRPC_PORT=6007
PHOENIX_WORKING_DIR=/phoenix-data

# Authentication (optional, for production)
# PHOENIX_ENABLE_AUTH=false
# PHOENIX_ADMIN_SECRET=changeme_admin_secret

# Database Configuration (optional, defaults to SQLite)
# PHOENIX_SQL_DATABASE_URL=postgresql://user:password@host:5432/phoenix
# Or individual PostgreSQL connection params:
# PHOENIX_POSTGRES_HOST=localhost
# PHOENIX_POSTGRES_PORT=5432
# PHOENIX_POSTGRES_USER=phoenix
# PHOENIX_POSTGRES_PASSWORD=phoenix_password
# PHOENIX_POSTGRES_DB=phoenix

# API Configuration (for automated testing)
# PHOENIX_API_KEY=phoenix_key_xxx
# PHOENIX_CLIENT_HEADERS=api_key=phoenix_key_xxx

# Prometheus Metrics
# PHOENIX_ENABLE_PROMETHEUS=false

# =============================================================================
# Jaeger Configuration
# =============================================================================
# Jaeger all-in-one doesn't require environment variables for basic usage
# It runs with in-memory storage by default (good for local testing)

# For authenticated collector endpoints (optional):
# JAEGER_AUTH_TOKEN=your_jwt_token
# JAEGER_USER=username
# JAEGER_PASSWORD=password

# Collector Configuration (for Jaeger v2 YAML config)
# JAEGER_LISTEN_HOST=localhost
# COLLECTOR_OTLP_ENABLED=true

# =============================================================================
# Integration Testing Configuration
# =============================================================================
# Set these in your test environment to enable automated testing

# Langfuse Test Configuration
TEST_LANGFUSE_PUBLIC_KEY=pk_test_xxx
TEST_LANGFUSE_SECRET_KEY=sk_test_xxx
TEST_LANGFUSE_BASE_URL=http://localhost:3000

# Opik Test Configuration
TEST_OPIK_API_KEY=opik_test_xxx
TEST_OPIK_URL=http://localhost:8080
TEST_OPIK_WORKSPACE=test

# Phoenix Test Configuration
TEST_PHOENIX_API_KEY=phoenix_test_xxx
TEST_PHOENIX_BASE_URL=http://localhost:6006

# Helicone Test Configuration
TEST_HELICONE_API_KEY=sk_helicone_test_xxx
TEST_HELICONE_BASE_URL=http://localhost:3001

# Jaeger Test Configuration (OTLP endpoint)
TEST_JAEGER_OTLP_HTTP=http://localhost:4318
TEST_JAEGER_OTLP_GRPC=http://localhost:4317

# =============================================================================
# Notes for Automated Integration Testing
# =============================================================================
#
# 1. Langfuse:
#    - Use headless initialization with LANGFUSE_INIT_* variables
#    - Or create project/keys via API after first user creation
#
# 2. Opik:
#    - Run `opik configure --use_local` to setup local instance
#    - API keys can be created via the UI at http://localhost:5173
#
# 3. Phoenix:
#    - Supports API key generation via API (requires PHOENIX_ADMIN_SECRET)
#    - POST /v1/api_keys endpoint with admin secret header
#
# 4. Helicone:
#    - Create API keys through the web UI after signup
#    - Keys are required for the gateway endpoint
#
# 5. Jaeger:
#    - No API keys needed for local testing
#    - OTLP endpoints are open by default
#
