# Observability Stack Configuration
# Copy this file to .env.observability and customize as needed

# Jaeger - Distributed Tracing
JAEGER_UI_PORT=16686
JAEGER_COLLECTOR_PORT=14268
JAEGER_OTLP_GRPC_PORT=4317
JAEGER_OTLP_HTTP_PORT=4318
JAEGER_LOG_LEVEL=info

# Zipkin - Distributed Tracing
ZIPKIN_PORT=9411

# Phoenix by Arize - LLM Observability
PHOENIX_UI_PORT=6006
PHOENIX_GRPC_PORT=6007

# Langfuse - LLM Monitoring & Prompt Management
LANGFUSE_PORT=3000
LANGFUSE_DB_NAME=langfuse
LANGFUSE_DB_USER=langfuse
LANGFUSE_DB_PASSWORD=langfuse_password
LANGFUSE_NEXTAUTH_SECRET=changeme_langfuse_secret_key_min_32_chars
LANGFUSE_SALT=changeme_langfuse_salt_key
LANGFUSE_TELEMETRY_ENABLED=true
LANGFUSE_EXPERIMENTAL=true

# Opik - LLM Experiment Tracking
OPIK_BACKEND_PORT=8080
OPIK_FRONTEND_PORT=5173
OPIK_DB_NAME=opik
OPIK_DB_USER=opik
OPIK_DB_PASSWORD=opik_password
OPIK_MYSQL_ROOT_PASSWORD=opik_root_password
OPIK_TELEMETRY_ENABLED=false

# Helicone - LLM Observability & Cost Tracking
HELICONE_PORT=3001
HELICONE_GATEWAY_PORT=8585
